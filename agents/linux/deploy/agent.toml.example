# /etc/sentinel-agent/agent.toml  (chmod 640, owner root, group sentinel-agent)

[server]
# The platform's ingestion API. Use https outside an isolated lab: with http, log lines and the
# API key travel in plaintext (the agent warns at startup).
url = "http://192.168.64.1:8000"
# File holding the key printed by `sentinel agents create` (chmod 600, owned by the agent user).
# Alternative: the SENTINEL_AGENT_KEY environment variable. The key is never read from this file.
key_file = "/etc/sentinel-agent/key"
# ca_file = "/etc/sentinel-agent/ca.pem"   # custom CA for https

[agent]
state_file = "/var/lib/sentinel-agent/state.json"
# Where to start a file that has no saved position: "end" (only new lines) or "beginning".
start_at = "end"
batch_lines = 200          # 1..500 (API limit)
batch_bytes = 1048576      # 1 KiB .. 1.3 MB
poll_interval = 0.5        # seconds between checks when idle

[[sources]]
path = "/var/log/auth.log"
source = "linux.auth"

# [[sources]]
# path = "/var/log/nginx/access.log"
# source = "nginx.access"

# --- Optional: let the platform block attackers on this host's firewall --------------------------
# Read only by `sentinel-agent-enforcer` (a separate, privileged service: see docs/AGENT.md). Without
# this section the agent never touches the firewall.
# [response]
# backend = "iptables"            # "iptables" (rules in a SENTINEL chain) or "log" (applies nothing)
# # MANDATORY (may be empty): addresses that can never be blocked, whatever the platform says.
# # Put here the address you SSH from, your monitoring, your office.
# never_block = ["203.0.113.7", "198.51.100.0/24"]
# poll_interval = 5               # seconds between two checks for actions (1..300)
# max_blocks = 100                # refuse new blocks beyond this many active ones
# max_ttl_seconds = 86400         # no block outlives this, even if the platform asks for more
# state_file = "/var/lib/sentinel-agent/blocks.json"
