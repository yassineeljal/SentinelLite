# Copy to deploy/.env and change every value. Never commit the real file.
POSTGRES_USER=sentinel
POSTGRES_PASSWORD=change-me
POSTGRES_DB=sentinel

# Address the API is published on. Keep 127.0.0.1 for local use and for OrbStack machines
# (they reach it through host.orb.internal). For UTM VMs set it to the Mac's address on the VM
# network: it varies (find it with `ifconfig | grep -A4 bridge` while a VM runs), see lab/README.md.
# Never use 0.0.0.0 (would expose the SIEM on your Wi-Fi).
SENTINEL_BIND_ADDR=127.0.0.1

# Enrichment (GeoIP on alerts). Run deploy/fetch-geoip.sh first, then set both lines below.
# Data by DB-IP.com, CC BY 4.0 (attribution in deploy/geoip/ATTRIBUTION.txt).
# SENTINEL_ENRICHMENT_ENABLED=true
# COMPOSE_PROFILES=enrichment
# Optional AbuseIPDB reputation (free key from abuseipdb.com). UNLIKE GeoIP, the PUBLIC source
# address of an alert is sent to abuseipdb.com; private addresses never are. Leave empty to keep it off.
# SENTINEL_ABUSEIPDB_API_KEY=
# SENTINEL_ABUSEIPDB_DAILY_LIMIT=900

# dry_run logs response actions without executing them. Use "enforce" only after
# measuring false positives (see docs/ARCHITECTURE.md section 8).
SENTINEL_RESPONDER_MODE=dry_run

# Dashboard sessions (see docs/DASHBOARD.md). Defaults to true (cookie sent over HTTPS only).
# Set to false ONLY for a plain-HTTP lab; never for anything reachable over a real network.
# SENTINEL_SESSION_COOKIE_SECURE=true
# SENTINEL_SESSION_TTL_HOURS=8

# Optional TOTP enrollment: generate one stable Fernet key (see docs/OPERATIONS.md).
# Back it up separately; do not regenerate on restart or commit it.
# SENTINEL_MFA_ENCRYPTION_KEY=
# Shared authentication attempt budgets (successful attempts count too).
# SENTINEL_AUTH_WINDOW_SECONDS=300
# SENTINEL_AUTH_ACCOUNT_ATTEMPTS=10
# SENTINEL_AUTH_IP_ATTEMPTS=50

# Automated response (DRY RUN only: records what WOULD be blocked, touches no firewall).
# Set SENTINEL_RESPONDER_ENABLED=true and COMPOSE_PROFILES=response (add enrichment if you use it).
# ALWAYS list your own address(es) first: a block on yourself would cut you off once enforcement exists.
# SENTINEL_RESPONDER_ENABLED=true
# COMPOSE_PROFILES=response
# SENTINEL_RESPONDER_ALLOWLIST=203.0.113.7,198.51.100.0/24
# SENTINEL_RESPONDER_MIN_SEVERITY=40
# SENTINEL_RESPONDER_TTL_SECONDS=3600
# SENTINEL_RESPONDER_MAX_BLOCKS_PER_MINUTE=10
# Discord webhook (a secret: anyone holding it can post in the channel). The responder announces
# every block and release there. Server settings > Integrations > Webhooks > Copy URL.
# SENTINEL_DISCORD_WEBHOOK_URL=https://discord.com/api/webhooks/<id>/<token>
